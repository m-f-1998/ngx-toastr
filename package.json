{
  "name": "@m-f-1998/ngx-toastr",
  "description": "Toastr for Angular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IQXLimited/ngx-toastr.git"
  },
  "version": "2.0.0",
  "license": "MIT",
  "author": "Matthew Frankland",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "demo:build": "ng build --configuration production --no-progress --base-href 'https://m-f-1998.github.io/ngx-toastr/'",
    "build": "ng-packagr -p src/lib/ng-package.json",
    "postbuild": "cpy README.md LICENSE dist",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --code-coverage --no-progress --browsers=ChromeHeadlessCustom",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "tsc-verify": "tsc --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "22.0.3",
    "@angular/common": "22.0.2",
    "@angular/compiler": "22.0.2",
    "@angular/compiler-cli": "22.0.2",
    "@angular/core": "22.0.2",
    "@angular/forms": "22.0.2",
    "@angular/language-service": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/router": "22.0.2",
    "@ctrl/ngx-github-buttons": "9.0.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "angular-eslint": "^22.0.0",
    "bootstrap": "5.3.8",
    "cpy-cli": "7.0.0",
    "eslint": "10.5.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.3.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "lodash-es": "4.18.1",
    "ng-packagr": "22.0.0",
    "puppeteer": "25.1.0",
    "rxjs": "7.8.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "volta": {
    "node": "24.17.0"
  }
}
